{
  "name": "migration-helper",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:code": "esbuild src/code.ts --bundle --outfile=code.js --target=es2017 --format=iife",
    "build:ui": "node scripts/build-ui.mjs",
    "build": "npm run build:code && npm run build:ui",
    "watch": "esbuild src/code.ts --bundle --outfile=code.js --target=es2017 --format=iife --watch",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.94.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@gravity/foundation": "^4.2.1",
    "@gravity/web-components-react": "^11.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
