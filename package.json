{
  "name": "migration-helper",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:code": "esbuild src/code.ts --bundle --outfile=code.js --target=es2017 --format=iife",
    "build:ui": "node scripts/build-ui.mjs",
    "build": "npm run build:code && npm run build:ui",
    "watch": "esbuild src/code.ts --bundle --outfile=code.js --target=es2017 --format=iife --watch",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.94.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.23.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-collapsible": "^1.1.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  }
}
